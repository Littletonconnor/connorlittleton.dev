---
const navLinks = [
  { label: "Writing", href: "/blog" },
  { label: "Projects", href: "/projects" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 w-full border-b backdrop-blur-sm"
  style="border-color: var(--color-border); background-color: color-mix(in srgb, var(--color-background) 80%, transparent);"
>
  <nav class="max-w-2xl mx-auto px-6 h-14 flex items-center justify-between">
    <a
      href="/"
      class="font-medium text-sm tracking-tight transition-opacity hover:opacity-70"
    >
      Connor Littleton
    </a>
    <ul class="flex items-center gap-6">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-sm transition-opacity hover:opacity-70",
                currentPath.startsWith(link.href)
                  ? "font-medium"
                  : "opacity-60",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
