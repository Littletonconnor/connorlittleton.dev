---
const socialLinks = [
  {
    label: "GitHub",
    href: "https://github.com/Littletonconnor",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/connor-littleton-31bb43135/",
  },
];

const year = new Date().getFullYear();
---

<footer class="w-full border-t" style="border-color: var(--color-border);">
  <div
    class="max-w-2xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <p class="text-sm" style="color: var(--color-muted);">
      &copy; {year} Connor Littleton
    </p>
    <ul class="flex items-center gap-5">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm transition-opacity hover:opacity-70"
              style="color: var(--color-muted);"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
