---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../lib/utils";
---

<Layout title="Projects | Connor Littleton" description="Open source projects and side experiments.">
  <div class="space-y-12">
    <header class="opacity-0 animate-fade-in-up">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-4">
        Projects
      </h1>
      <p class="text-lg" style="color: var(--color-muted);">
        Open source projects and side experiments.
      </p>
    </header>

    <ul class="space-y-1 opacity-0 animate-fade-in-up delay-1">
      {
        projects.map((project) => (
          <li>
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col sm:flex-row sm:items-center sm:justify-between py-4 -mx-3 px-3 rounded-lg transition-colors"
              onmouseover="this.style.backgroundColor='var(--color-surface-hover)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0"
                  style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    style="color: var(--color-muted);"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                </div>
                <div class="space-y-0.5">
                  <span class="font-medium block">{project.name}</span>
                  <span class="text-sm block" style="color: var(--color-muted);">
                    {project.description}
                  </span>
                </div>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mt-2 sm:mt-0 sm:ml-4 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
                style="color: var(--color-muted);"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
