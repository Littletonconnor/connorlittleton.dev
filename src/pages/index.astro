---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { projects } from "../lib/utils";

const posts = await getCollection("blog");
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = projects.slice(0, 3);
---

<Layout title="Connor Littleton">
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="opacity-0 animate-fade-in-up">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-6">
        Software Engineer
      </h1>
      <p class="text-lg leading-relaxed" style="color: var(--color-muted);">
        Hi, I'm Connor. I'm a Web Engineer at <a
          href="https://www.wealthfront.com"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 transition-opacity hover:opacity-70"
          style="text-decoration-color: var(--color-border-hover);"
          >Wealthfront</a
        >, where I work on investing products and lead our web on-call team. I'm
        passionate about building great user experiences and always eager to
        tackle new challenges.
      </p>
    </section>

    <!-- Writing Section -->
    <section class="opacity-0 animate-fade-in-up delay-1">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-sm font-medium uppercase tracking-wider" style="color: var(--color-muted);">
          Writing
        </h2>
        <a
          href="/blog"
          class="text-sm transition-opacity hover:opacity-70"
          style="color: var(--color-muted);"
        >
          View all &rarr;
        </a>
      </div>
      <ul class="space-y-1">
        {
          recentPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}`}
                class="group flex items-center justify-between py-3 -mx-3 px-3 rounded-lg transition-colors"
                style="--hover-bg: var(--color-surface-hover);"
                onmouseover="this.style.backgroundColor='var(--color-surface-hover)'"
                onmouseout="this.style.backgroundColor='transparent'"
              >
                <span class="font-medium">{post.data.title}</span>
                <span
                  class="text-sm tabular-nums"
                  style="color: var(--color-muted);"
                >
                  {new Date(post.data.pubDate).toLocaleDateString("en-US", {
                    month: "short",
                    year: "numeric",
                  })}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Projects Section -->
    <section class="opacity-0 animate-fade-in-up delay-2">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-sm font-medium uppercase tracking-wider" style="color: var(--color-muted);">
          Projects
        </h2>
        <a
          href="/projects"
          class="text-sm transition-opacity hover:opacity-70"
          style="color: var(--color-muted);"
        >
          View all &rarr;
        </a>
      </div>
      <ul class="space-y-1">
        {
          featuredProjects.map((project) => (
            <li>
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col sm:flex-row sm:items-center sm:justify-between py-3 -mx-3 px-3 rounded-lg transition-colors"
                onmouseover="this.style.backgroundColor='var(--color-surface-hover)'"
                onmouseout="this.style.backgroundColor='transparent'"
              >
                <span class="font-medium">{project.name}</span>
                <span class="text-sm" style="color: var(--color-muted);">
                  {project.description}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
