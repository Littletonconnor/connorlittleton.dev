---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog");
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Writing | Connor Littleton" description="Articles about web development, engineering, and technology.">
  <div class="space-y-12">
    <header class="opacity-0 animate-fade-in-up">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-4">
        Writing
      </h1>
      <p class="text-lg" style="color: var(--color-muted);">
        Thoughts on web development, engineering practices, and technology.
      </p>
    </header>

    <ul class="space-y-1 opacity-0 animate-fade-in-up delay-1">
      {
        sortedPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col sm:flex-row sm:items-center sm:justify-between py-4 -mx-3 px-3 rounded-lg transition-colors"
              onmouseover="this.style.backgroundColor='var(--color-surface-hover)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              <div class="space-y-1">
                <span class="font-medium block">{post.data.title}</span>
                <span class="text-sm block" style="color: var(--color-muted);">
                  {post.data.description}
                </span>
              </div>
              <span
                class="text-sm tabular-nums mt-2 sm:mt-0 sm:ml-4 shrink-0"
                style="color: var(--color-muted);"
              >
                {new Date(post.data.pubDate).toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
